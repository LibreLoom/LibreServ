#!/bin/bash
# system-restore - AppRun Test Suite restore script
# Exercises: restoring from a backup archive

set -euo pipefail

CONFIG_FILE="${1:-}"
if [[ -z "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file path required as argument 1"
    exit 1
fi

INSTANCE_ID=$(jq -r '.instance_id' "$CONFIG_FILE")
APP_DATA_PATH=$(jq -r '.app_data_path' "$CONFIG_FILE")
CONFIG_DIR=$(jq -r '.config_dir' "$CONFIG_FILE")
BACKUP_ID=$(jq -r '.options.backup_id // ""' "$CONFIG_FILE")

echo ">> [apprun-test] Running restore for instance $INSTANCE_ID"

BACKUP_DIR="${APP_DATA_PATH}/backups"

if [[ -n "$BACKUP_ID" && -f "${BACKUP_DIR}/${BACKUP_ID}.tar.gz" ]]; then
    tar -xzf "${BACKUP_DIR}/${BACKUP_ID}.tar.gz" \
        -C "$APP_DATA_PATH" 2>/dev/null || true
    echo ">> [apprun-test] Restored from backup: ${BACKUP_ID}"
else
    echo ">> [apprun-test] No backup specified or backup file not found — skipping"
fi

echo ">> [apprun-test] Restore completed successfully"
exit 0

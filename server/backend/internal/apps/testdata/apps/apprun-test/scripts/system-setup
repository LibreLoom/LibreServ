#!/bin/bash
# system-setup - AppRun Test Suite initial setup
# Exercises: reading config JSON, all config keys, server context, runtime info,
# writing exposed_info JSON output, creating data dirs, writing config files

set -euo pipefail

CONFIG_FILE="${1:-}"
if [[ -z "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file path required as argument 1"
    exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file does not exist: $CONFIG_FILE"
    exit 1
fi

INSTANCE_ID=$(jq -r '.instance_id' "$CONFIG_FILE")
APP_ID=$(jq -r '.app_id' "$CONFIG_FILE")
INSTALL_PATH=$(jq -r '.install_path' "$CONFIG_FILE")
APP_DATA_PATH=$(jq -r '.app_data_path' "$CONFIG_FILE")
CONFIG_PATH=$(jq -r '.config_path' "$CONFIG_FILE")
CONFIG_DIR=$(jq -r '.config_dir' "$CONFIG_FILE")
COMPOSE_FILE=$(jq -r '.runtime.compose_file' "$CONFIG_FILE")
PROJECT_NAME=$(jq -r '.runtime.project_name' "$CONFIG_FILE")

SERVER_PORT=$(jq -r '.server.server_port' "$CONFIG_FILE")
SERVER_MODE=$(jq -r '.server.server_mode' "$CONFIG_FILE")
SERVER_HOST=$(jq -r '.server.server_host' "$CONFIG_FILE")
SERVER_URL=$(jq -r '.server.server_url' "$CONFIG_FILE")
DEFAULT_DOMAIN=$(jq -r '.server.default_domain' "$CONFIG_FILE")
CADDY_MODE=$(jq -r '.server.caddy_mode' "$CONFIG_FILE")
ACME_EMAIL=$(jq -r '.server.acme_email' "$CONFIG_FILE")
SMTP_HOST=$(jq -r '.server.smtp_host' "$CONFIG_FILE")
SMTP_PORT=$(jq -r '.server.smtp_port' "$CONFIG_FILE")
SMTP_USERNAME=$(jq -r '.server.smtp_username' "$CONFIG_FILE")
SMTP_PASSWORD=$(jq -r '.server.smtp_password' "$CONFIG_FILE")
SMTP_FROM=$(jq -r '.server.smtp_from' "$CONFIG_FILE")
SMTP_USE_TLS=$(jq -r '.server.smtp_use_tls' "$CONFIG_FILE")
SMTP_SKIP_VERIFY=$(jq -r '.server.smtp_skip_verify' "$CONFIG_FILE")
TUNNEL_ENABLED=$(jq -r '.server.tunnel_enabled' "$CONFIG_FILE")
TUNNEL_PROVIDER=$(jq -r '.server.tunnel_provider' "$CONFIG_FILE")
TUNNEL_TOKEN=$(jq -r '.server.tunnel_token' "$CONFIG_FILE")
DNS_PROVIDER=$(jq -r '.server.dns_provider' "$CONFIG_FILE")

echo ">> [apprun-test] Starting setup..."
echo ">> instance_id=$INSTANCE_ID"
echo ">> app_id=$APP_ID"
echo ">> install_path=$INSTALL_PATH"
echo ">> app_data_path=$APP_DATA_PATH"
echo ">> config_path=$CONFIG_PATH"
echo ">> config_dir=$CONFIG_DIR"
echo ">> compose_file=$COMPOSE_FILE"
echo ">> project_name=$PROJECT_NAME"
echo ">> server_url=$SERVER_URL"
echo ">> default_domain=$DEFAULT_DOMAIN"
echo ">> caddy_mode=$CADDY_MODE"
echo ">> smtp_host=$SMTP_HOST"
echo ">> smtp_port=$SMTP_PORT"

mkdir -p "$APP_DATA_PATH/app-data"
mkdir -p "$APP_DATA_PATH/app-logs"
mkdir -p "$CONFIG_DIR/app-config"

SETUP_TOKEN=$(head -c 32 /dev/urandom | xxd -p | head -c 32)
ADMIN_USERNAME="admin_${INSTANCE_ID:0:8}"
ADVANCED_TOKEN=$(head -c 24 /dev/urandom | xxd -p | head -c 24)
BASE_URL="http://localhost:$(jq -r '.options.http_port // 8880' "$CONFIG_FILE")"

cat > "$CONFIG_DIR/app-config/test.conf" <<CONF
# Generated by apprun-test system-setup
instance_id=${INSTANCE_ID}
app_id=${APP_ID}
server_url=${SERVER_URL}
setup_token=${SETUP_TOKEN}
CONF

chmod -R 755 "$APP_DATA_PATH"
chmod -R 755 "$CONFIG_DIR"

echo ">> [apprun-test] Setup completed successfully"

cat <<EOF
{"exposed_info": {"setup_token": "$SETUP_TOKEN", "base_url": "$BASE_URL", "admin_username": "$ADMIN_USERNAME", "advanced_token": "$ADVANCED_TOKEN"}}
EOF
exit 0

#!/bin/bash
# system-backup - AppRun Test Suite backup script
# Exercises: creating a backup archive, returning backup_id in data

set -euo pipefail

CONFIG_FILE="${1:-}"
if [[ -z "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file path required as argument 1"
    exit 1
fi

INSTANCE_ID=$(jq -r '.instance_id' "$CONFIG_FILE")
APP_DATA_PATH=$(jq -r '.app_data_path' "$CONFIG_FILE")
CONFIG_DIR=$(jq -r '.config_dir' "$CONFIG_FILE")

echo ">> [apprun-test] Running backup for instance $INSTANCE_ID"

BACKUP_ID="backup-${INSTANCE_ID}-$(date +%Y%m%d%H%M%S)"
BACKUP_DIR="${APP_DATA_PATH}/backups"
mkdir -p "$BACKUP_DIR"

tar -czf "${BACKUP_DIR}/${BACKUP_ID}.tar.gz" \
    -C "$APP_DATA_PATH" app-data app-logs \
    -C "$CONFIG_DIR" app-config 2>/dev/null || true

echo ">> [apprun-test] Backup created: ${BACKUP_ID}"

cat <<EOF
{"backup_id": "$BACKUP_ID"}
EOF
exit 0

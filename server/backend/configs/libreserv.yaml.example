server:
    host: 0.0.0.0
    port: 8080
    mode: production
database:
    path: ./dev/data/libreserv.db
auth:
    jwt_secret: ""
    csrf_secret: ""
    mfa:
        # AES-GCM key wrapping TOTP secrets at rest. Empty -> auto-generated +
        # persisted on first run (must stay stable or enrolled TOTP methods
        # can't be decrypted). Set via LIBRESERV_AUTH_MFA_TOTP_ENCRYPTION_KEY
        # for read-only configs.
        totp_encryption_key: ""
        # WebAuthn (passkeys + security keys). Leave rp_id/origins unset to
        # disable (methods return "not configured"); requires https origins.
        webauthn:
            rp_id: ""
            rp_display_name: ""
            origins: []
            timeout: 60s
apps:
    data_path: ./dev/apps
    catalog_path: ./apps
    repo_pull_interval: 6h
runtime:
    method: auto
    socket_path: ""
    tcp:
        host: ""
        port: 0
        use_tls: false
        cert_path: ""
    binary: podman
logging:
    level: info
    path: ./dev/logs
network:
    caddy:
        mode: enabled
        admin_api: 127.0.0.1:2019
        # If you run LibreServ behind a reverse proxy, set LIBRESERV_TRUSTED_PROXIES
        # (environment variable, comma-separated CIDRs or IPs, e.g. "127.0.0.1,::1")
        # so X-Forwarded-For is honored only from those sources. The default trusts
        # loopback only — anything else lets clients spoof their IP for rate limits.
        config_path: ./dev/caddy/Caddyfile
        certs_path: ./dev/caddy/certs
        default_domain: ""
        email: ""
        auto_https: false
        reload:
            retries: 5
            backoff_min: 1s
            backoff_max: 30s
            jitter_fraction: 0.1
            attempt_timeout: 10s
        logging:
            output: stdout
            file: ""
            format: console
            level: ""
    mdns:
        enabled: true
    tunnel:
        provider: ""
        token: ""
        enabled: false
    acme:
        external:
            enabled: false
            use_podman: false
            container_image: ""
            data_path: ""
            dns_provider: ""
            dns_env: {}
            email: ""
            staging: false
            ca_dir_url: ""
            key_type: ""
            certs_path: ""
cors:
    allowed_origins: []
smtp:
    host: ""
    port: 587
    username: ""
    password: ""
    from: ""
    use_tls: false
    skip_verify: false # WARNING: Setting this to true disables TLS certificate validation, allowing man-in-the-middle attacks on email notifications
notify:
    enabled: false
    support_recipients: []
    support_subject: ""
    support_body: ""
    welcome_subject: ""
    welcome_body: ""
updates:
    base_url: https://gt.plainskill.net/api/v1
    owner: libreloom
    repo: libreserv
support:
    inference_base_url: "https://api.routing.run/v1"
    agent:
        # main_model: the AI model used for agent conversations.
        # When using LibreServ Connect, available models are fetched live.
        # When using BYOK, enter the model ID your provider offers.
        main_model: ""
        # review_model: the AI model that reviews tool calls for safety.
        # If empty, the main_model is used for review as well.
        review_model: ""
        # summary_model: an optional model that summarizes the session so the
        # review model can judge tool calls with real context (what the user
        # wants, what the agent has done, any user data involved). If empty, the
        # reviewer gets a truncated transcript instead.
        summary_model: ""
        review_enabled: true
        max_turns: 10
        turn_timeout: 5m
        system_plan_id: "basic"
        # sandbox: the OS-level boundary that runs the agent's shell commands.
        # The agent's bash tool never runs commands directly on the host — it
        # runs them inside this sandbox, which shows the command a read-only view
        # of the system and only lets it change the directories listed below.
        # This is the real security boundary; the review model is advisory.
        #   mode:     "auto" (use bubblewrap when available), "bwrap"
        #            (require bubblewrap, refuse commands if missing), or "off"
        #            (no sandbox — development only).
        #   workdirs: directories the agent may write to. Everything else under /
        #            is read-only inside the sandbox.
        #   network: allow the agent's commands to reach the network (needed for
        #            the Podman socket and installing packages).
        sandbox:
            mode: "auto"
            workdirs:
                - /var/lib/libreserv
                - /var/log/libreserv
            network: true
    # pricing: per-1M-token costs for models. Only models with entries here will
    # have accurate cost tracking. Models without pricing entries are tracked at $0 cost.
    # Add entries for any model your provider offers if you want cost visibility.
    pricing:
        route/mimo-v2.5-pro:
            input_per_1m: 0.45
            output_per_1m: 1.00
            cache_per_1m: 0.10
        route/kimi-k2.6:
            input_per_1m: 0.46
            output_per_1m: 2.00
            cache_per_1m: 0.10
        route/deepseek-v4-pro:
            input_per_1m: 0.49
            output_per_1m: 0.74
            cache_per_1m: 0.003
    plans:
        # price_monthly is in cents (e.g. 1500 = $15.00)
        - id: free
          name: "Free"
          price_monthly: 0
          credit_cap_usd: 0
          human_escalation: false
          self_healing: false
          self_healing_default: false
        - id: basic
          name: "Basic Support"
          price_monthly: 1500
          credit_cap_usd: 10
          human_escalation: false
          self_healing: true
          self_healing_default: false
        - id: premium
          name: "Premium Support"
          price_monthly: 2500
          credit_cap_usd: 20
          human_escalation: true
          self_healing: true
          self_healing_default: true

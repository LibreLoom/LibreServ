server:
    host: 0.0.0.0
    port: 8080
    mode: production
database:
    path: ./dev/data/libreserv.db
auth:
    jwt_secret: ""
    secret_file: ""
    csrf_secret: ""
    # allow_registration controls whether anyone can create an account.
    # Keep this off for private or admin-managed servers.
    allow_registration: false
apps:
    data_path: ./dev/apps
    catalog_path: ./apps
    repos: []
    repo_pull_interval: 6h
runtime:
    method: auto
    socket_path: ""
    tcp:
        host: ""
        port: 0
        use_tls: false
        cert_path: ""
    ssh:
        host: ""
        user: ""
        key_path: ""
    timeout: 30s
    binary: podman
logging:
    level: info
    path: ./dev/logs
network:
    caddy:
        mode: enabled
        admin_api: localhost:2019
        config_path: ./dev/caddy/Caddyfile
        certs_path: ./dev/caddy/certs
        default_domain: ""
        email: ""
        auto_https: false
        reload:
            retries: 5
            backoff_min: 1s
            backoff_max: 30s
            jitter_fraction: 0.1
            attempt_timeout: 10s
        logging:
            output: stdout
            file: ""
            format: console
            level: ""
    mdns:
        enabled: true
    upnp:
        enabled: false
        timeout: 5
    tunnel:
        provider: ""
        token: ""
        enabled: false
    bluetooth:
        enabled: false
    acme:
        external:
            enabled: false
            use_podman: false
            container_image: ""
            data_path: ""
            dns_provider: ""
            dns_env: {}
            email: ""
            staging: false
            ca_dir_url: ""
            key_type: ""
            certs_path: ""
    dns:
        provider: ""
        api_token: ""
cors:
    allowed_origins: []
license:
    entitlement_file: ""
    public_key_file: ""
smtp:
    host: ""
    port: 587
    username: ""
    password: ""
    from: ""
    use_tls: false
    skip_verify: false # WARNING: Setting this to true disables TLS certificate validation, allowing man-in-the-middle attacks on email notifications
notify:
    enabled: false
    support_recipients: []
    support_subject: ""
    support_body: ""
    welcome_subject: ""
    welcome_body: ""
updates:
    base_url: https://gt.plainskill.net/api/v1
    owner: libreloom
    repo: libreserv
support:
    # server_url: the LibreServ support service that provides AI inference and billing.
    # Your server connects to this for AI capabilities — the inference API key is held
    # by the support service, never on your machine.
    server_url: "https://support.serv.libreloom.org"
    # device_token: authenticates your server to the support service.
    # Your administrator provides this when setting up your subscription.
    device_token: ""
    # device_id: a unique name for this server, used to identify your subscription
    # and track credit usage. Must match what the support service has on file.
    device_id: ""
    # inference_base_url: only used for BYOK (Bring Your Own Key) mode.
    # When using the shared support service, this is ignored.
    inference_base_url: "https://api.routing.run/v1"
    # default_model: the AI model used when no specific model is selected.
    # Available models are fetched live from the support service.
    default_model: ""
    # billing_mode: how credit costs are calculated.
    #   "token"  — cost based on token usage (for token-billed providers)
    #   "request" — flat cost per request (for request-billed providers like routing.run)
    billing_mode: "token"
    agent:
        max_turns: 10
        turn_timeout: 5m
        snapshot_before_writes: true
        system_plan_id: "basic"
    # agents: define AI agent personas. Model can be left empty to use default_model.
    # Tools are grouped by name: "podman", "files", "diagnostics", "snapshots".
    agents:
        - id: agent-1
          trigger: chat
          model: ""
          avatar_shape: diamond
          avatar_color: "#FF6B35"
          tools: ["podman", "files", "diagnostics", "snapshots"]
          max_turns: 50
        - id: agent-2
          trigger: chat
          model: ""
          avatar_shape: circle
          avatar_color: "#4ECDC4"
          tools: ["podman", "files", "diagnostics", "snapshots"]
          max_turns: 50
        - id: self-healing
          trigger: container_unhealthy
          model: ""
          tools: ["podman", "diagnostics", "files"]
          max_turns: 5
          permission_mode: auto
    # pricing: per-1M-token costs for models. Only models with entries here will
    # have accurate cost tracking. Models without pricing entries are tracked at $0 cost.
    # Add entries for any model your provider offers if you want cost visibility.
    pricing:
        route/mimo-v2.5-pro:
            input_per_1m: 0.45
            output_per_1m: 1.00
            cache_per_1m: 0.10
        route/kimi-k2.6:
            input_per_1m: 0.46
            output_per_1m: 2.00
            cache_per_1m: 0.10
        route/deepseek-v4-pro:
            input_per_1m: 0.49
            output_per_1m: 0.74
            cache_per_1m: 0.003
    plans:
        # price_monthly is in cents (e.g. 1500 = $15.00)
        - id: free
          name: "Free"
          price_monthly: 0
          credit_cap_usd: 0
          human_escalation: false
          self_healing: false
          self_healing_default: false
        - id: basic
          name: "Basic Support"
          price_monthly: 1500
          credit_cap_usd: 10
          human_escalation: false
          self_healing: true
          self_healing_default: false
        - id: premium
          name: "Premium Support"
          price_monthly: 2500
          credit_cap_usd: 20
          human_escalation: true
          self_healing: true
          self_healing_default: true

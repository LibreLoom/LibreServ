#!/bin/bash
# system-setup - LibreChat initial setup script

set -euo pipefail

CONFIG_FILE="${1:-}"
if [[ -z "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file path required"
    exit 1
fi

APP_DATA_PATH=$(jq -r '.app_data_path' "$CONFIG_FILE")
CONFIG_DIR=$(jq -r '.config_dir' "$CONFIG_FILE")
HTTP_PORT=$(jq -r '.options.http_port // "3080"' "$CONFIG_FILE")
APP_TITLE=$(jq -r '.options.app_title // "LibreChat"' "$CONFIG_FILE")
ALLOW_REGISTRATION=$(jq -r '.options.allow_registration // true' "$CONFIG_FILE")
ALLOW_SOCIAL_LOGIN=$(jq -r '.options.allow_social_login // false' "$CONFIG_FILE")
OPENAI_API_KEY=$(jq -r '.options.openai_api_key // ""' "$CONFIG_FILE")
ANTHROPIC_API_KEY=$(jq -r '.options.anthropic_api_key // ""' "$CONFIG_FILE")
GOOGLE_KEY=$(jq -r '.options.google_key // ""' "$CONFIG_FILE")
OLLAMA_BASE_URL=$(jq -r '.options.ollama_base_url // ""' "$CONFIG_FILE")
ENABLE_MEILISEARCH=$(jq -r '.options.enable_meilisearch // true' "$CONFIG_FILE")
MEILI_MASTER_KEY=$(jq -r '.options.meili_master_key // ""' "$CONFIG_FILE")
JWT_SECRET=$(jq -r '.options.jwt_secret // ""' "$CONFIG_FILE")
JWT_REFRESH_SECRET=$(jq -r '.options.jwt_refresh_secret // ""' "$CONFIG_FILE")
CREDS_KEY=$(jq -r '.options.creds_key // ""' "$CONFIG_FILE")
CREDS_IV=$(jq -r '.options.creds_iv // ""' "$CONFIG_FILE")

echo ">> [LibreChat] Starting initial setup..."

mkdir -p "$CONFIG_DIR/librechat"
mkdir -p "$APP_DATA_PATH/librechat/images"
mkdir -p "$APP_DATA_PATH/librechat/uploads"
mkdir -p "$APP_DATA_PATH/librechat/logs"
mkdir -p "$APP_DATA_PATH/mongodb"
mkdir -p "$APP_DATA_PATH/meilisearch"
mkdir -p "$APP_DATA_PATH/backups"

if [[ -z "$JWT_SECRET" ]]; then
    JWT_SECRET=$(openssl rand -hex 32)
fi
if [[ -z "$JWT_REFRESH_SECRET" ]]; then
    JWT_REFRESH_SECRET=$(openssl rand -hex 32)
fi
if [[ -z "$CREDS_KEY" ]]; then
    CREDS_KEY=$(openssl rand -hex 32)
fi
if [[ -z "$CREDS_IV" ]]; then
    CREDS_IV=$(openssl rand -hex 16)
fi
if [[ -z "$MEILI_MASTER_KEY" ]]; then
    MEILI_MASTER_KEY=$(openssl rand -hex 16)
fi

cat > "$CONFIG_DIR/librechat/librechat.yaml" <<YAML
version: 1.2.8
cache: true

registration:
  socialLogins: []
  allowedDomains: []

rateLimits:
  fileUploads:
    ipMax: 100
    ipWindowInMinutes: 60
    userMax: 50
    userWindowInMinutes: 60
  conversationsImport:
    ipMax: 100
    ipWindowInMinutes: 60
    userMax: 50
    userWindowInMinutes: 60
YAML

if [[ -n "$OLLAMA_BASE_URL" ]]; then
    cat >> "$CONFIG_DIR/librechat/librechat.yaml" <<YAML

endpoints:
  custom:
    - name: "Ollama"
      apiKey: "ollama"
      baseURL: "${OLLAMA_BASE_URL}/v1"
      models:
        default: ["llama3.2", "llama3.1", "mistral", "codellama", "phi"]
        fetch: true
      titleConvo: true
      titleModel: "llama3.2"
      summarize: false
      summaryModel: "llama3.2"
      forcePrompt: false
      modelDisplayLabel: "Ollama"
YAML
fi

chmod 644 "$CONFIG_DIR/librechat/librechat.yaml"

cat > "$CONFIG_DIR/librechat/secrets.env" <<EOF
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
CREDS_KEY=${CREDS_KEY}
CREDS_IV=${CREDS_IV}
MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
EOF
chmod 600 "$CONFIG_DIR/librechat/secrets.env"

chmod -R 755 "$APP_DATA_PATH"
chmod -R 755 "$CONFIG_DIR"

echo ">> [LibreChat] Setup completed successfully"

cat <<EOF
{"exposed_info": {"meili_master_key": "$MEILI_MASTER_KEY", "jwt_secret": "$JWT_SECRET", "jwt_refresh_secret": "$JWT_REFRESH_SECRET", "creds_key": "$CREDS_KEY", "creds_iv": "$CREDS_IV"}}
EOF
exit 0

version: "3"
services:
  homeassistant:
    image: lscr.io/linuxserver/homeassistant:latest
    container_name: "{{.instance_id}}-homeassistant"
    environment:
      - PUID={{.puid}}
      - PGID={{.pgid}}
      - TZ={{.timezone}}
    volumes:
      - "{{ dataPath }}/config:/config:z"
    ports:
      - "{{.port}}:8123"
    restart: unless-stopped
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.name={{.app_name}}"

#!/bin/bash
# system-setup - SearXNG initial setup script

set -euo pipefail

CONFIG_FILE="${1:-}"
if [[ -z "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file path required"
    exit 1
fi

APP_DATA_PATH=$(jq -r '.app_data_path' "$CONFIG_FILE")
CONFIG_DIR=$(jq -r '.config_dir' "$CONFIG_FILE")
HTTP_PORT=$(jq -r '.options.http_port // "8080"' "$CONFIG_FILE")
BASE_URL=$(jq -r '.options.base_url // ""' "$CONFIG_FILE")
INSTANCE_NAME=$(jq -r '.options.instance_name // "LibreServ SearXNG"' "$CONFIG_FILE")
AUTOCOMPLETE=$(jq -r '.options.autocomplete // "duckduckgo"' "$CONFIG_FILE")
SAFE_SEARCH=$(jq -r '.options.safe_search // "1"' "$CONFIG_FILE")
SECRET_KEY=$(jq -r '.options.secret_key // ""' "$CONFIG_FILE")

echo ">> [SearXNG] Starting initial setup..."

mkdir -p "$CONFIG_DIR/searxng"
mkdir -p "$APP_DATA_PATH/redis"
mkdir -p "$APP_DATA_PATH/backups"

if [[ -z "$SECRET_KEY" ]]; then
    SECRET_KEY=$(openssl rand -hex 32)
fi

cat > "$CONFIG_DIR/searxng/settings.yml" <<SETTINGS
use_default_settings: true

general:
  instance_name: "${INSTANCE_NAME}"
  contact_url: false
  enable_metrics: false

search:
  safe_search: ${SAFE_SEARCH}
  autocomplete: "${AUTOCOMPLETE}"
  default_lang: "auto"

server:
  secret_key: "${SECRET_KEY}"
  limiter: true
  image_proxy: true
  method: "POST"

ui:
  static_use_hash: true
  default_theme: simple
  infinite_scroll: true
  results_on_new_tab: false

redis:
  url: redis://redis:6379/0

outgoing:
  request_timeout: 3.0
  max_request_timeout: 10.0
SETTINGS

chmod 644 "$CONFIG_DIR/searxng/settings.yml"
chmod -R 755 "$APP_DATA_PATH"
chmod -R 755 "$CONFIG_DIR"

echo ">> [SearXNG] Setup completed successfully"

cat <<EOF
{"exposed_info": {"secret_key": "$SECRET_KEY", "base_url": "${BASE_URL:-http://localhost:${HTTP_PORT}/}", "test_field": "hello_from_script_$(date +%s)"}}
EOF
exit 0

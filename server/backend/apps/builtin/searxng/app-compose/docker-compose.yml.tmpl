services:
  searxng:
    image: searxng/searxng:1.5.0
    container_name: "{{.instance_id}}-searxng"
    restart: unless-stopped
    ports:
      - "{{.http_port}}:8080"
    environment:
      - "SEARXNG_BASE_URL={{if .base_url}}{{.base_url}}{{else}}http://localhost:{{.http_port}}/{{end}}"
      - "SEARXNG_SECRET={{.secret_key}}"
    volumes:
      - "{{ configPath }}/searxng:/etc/searxng:rw,z"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,size=100m
    depends_on:
      - redis
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.name={{.app_name}}"
    networks:
      - searxng-net

  redis:
    image: redis:7.4-alpine
    container_name: "{{.instance_id}}-redis"
    restart: unless-stopped
    command: redis-server --save 30 1 --loglevel warning
    volumes:
      - "{{ dataPath }}/redis:/data:z"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.component=redis"
    networks:
      - searxng-net

networks:
  searxng-net:
    driver: bridge

services:
  convertx:
    image: ghcr.io/c4illin/convertx:2.0.3
    container_name: "{{.instance_id}}-convertx"
    restart: unless-stopped
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:noexec,nosuid,size=100m
    ports:
      - "{{.http_port}}:3000"
    environment:
      - "HTTP_ALLOWED={{.http_allowed}}"
      - "ACCOUNT_REGISTRATION={{.account_registration}}"
      - "ALLOW_UNAUTHENTICATED={{.allow_unauthenticated}}"
    volumes:
      - "{{ dataPath }}/convertx:/app/data:z"
    labels:
      - "libreserv.app={{.instance_id}}"
      - "libreserv.app.name={{.app_name}}"

# Luna Connect Instance {INSTANCE}
# Generated by luna-connect/deploy/setup.sh — do not edit directly.
# Config: /etc/luna-connect/luna-connect-{INSTANCE}.yaml

[Unit]
Description=Luna Connect Server (instance {INSTANCE})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luna-connect
Group=luna-connect
WorkingDirectory=/opt/luna-connect
Environment=LUNACONNECT_CONFIG=/etc/luna-connect/luna-connect-{INSTANCE}.yaml
ExecStart=/opt/luna-connect/luna-connect
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luna-connect /var/log/luna-connect /opt/luna-connect /etc/luna-connect
PrivateTmp=true

[Install]
WantedBy=multi-user.target

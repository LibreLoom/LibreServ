#!/bin/sh
# LibreServ CI Launcher — detects platform, delegates to the right binary,
# rebuilds it if the source is newer than the binary.
set -e

SELF="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$SELF/ci-source/bin"
SOURCE_DIR="$SELF/ci-source"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$OS" in
  linux)  PLATFORM="linux-$ARCH" ;;
  darwin) PLATFORM="darwin-$ARCH" ;;
  freebsd) PLATFORM="freebsd-$ARCH" ;;
  *)
    echo "Unsupported OS: $OS" >&2
    exit 1
    ;;
esac

# Normalize arch
case "$ARCH" in
  x86_64|amd64) PLATFORM="${PLATFORM%%-*}-amd64" ;;
  aarch64|arm64) PLATFORM="${PLATFORM%%-*}-arm64" ;;
esac

CI_BIN="$BIN_DIR/ci-$PLATFORM"

# Rebuild if missing or if any Go source is newer than the binary
needs_build() {
  [ ! -f "$CI_BIN" ] && return 0
  [ -n "$(find "$SOURCE_DIR" -name '*.go' -newer "$CI_BIN" -print -quit)" ] && return 0
  return 1
}

if needs_build; then
  echo "CI binary is stale or missing, rebuilding for $PLATFORM..." >&2
  mkdir -p "$BIN_DIR"
  (cd "$SOURCE_DIR" && GOOS="${PLATFORM%%-*}" GOARCH="${PLATFORM##*-}" go build -o "bin/ci-$PLATFORM" ./cmd/ci)
  echo "Build complete!" >&2
  echo "" >&2
fi

exec "$CI_BIN" "$@"

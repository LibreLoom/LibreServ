# LibreServ Connect Instance {INSTANCE}
# This file is generated by connect/deploy/setup.sh — do not edit directly.
# To change configuration, edit /etc/libreserv-connect/connect-{INSTANCE}.yaml

[Unit]
Description=LibreServ Connect Server (instance {INSTANCE})
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=libreserv-connect
Group=libreserv-connect
WorkingDirectory=/opt/libreserv-connect
Environment=CONNECT_CONFIG=/etc/libreserv-connect/connect-{INSTANCE}.yaml
ExecStart=/opt/libreserv-connect/connect-server
Restart=always
RestartSec=3

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/libreserv-connect /var/log/libreserv-connect /opt/libreserv-connect /etc/libreserv-connect
PrivateTmp=true

[Install]
WantedBy=multi-user.target

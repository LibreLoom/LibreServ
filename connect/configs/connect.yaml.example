server:
    address: ""
    port: 8080

database:
    path: connect.db

auth:
    device_token_secret: CHANGE_ME
    admin_token_secret: CHANGE_ME
    customer_token_secret: CHANGE_ME
    session_ttl_hours: 168

stripe:
    enabled: false
    secret_key: ""
    webhook_secret: ""
    price_free: ""
    price_lite: ""
    price_one: ""

# Fallback email settings. The preferred way to configure email is through
# the admin UI at Settings → Service Providers (service: smtp).
smtp:
    host: smtp.libreloom.org
    port: 587
    username: ""
    password: ""
    from: noreply@libreloom.org
    use_tls: true

# Fallback DNS settings. The preferred way to configure DNS is through
# the admin UI at Settings → Service Providers (service: dns).
dns:
    provider: cloudflare
    api_token: ""
    zone: libreloom.org
    nameservers: []

inference:
    provider: neuralwatt
    base_url: https://inference.neuralwatt.dev/v1
    api_key: ""
    enabled: false

# Fallback backup settings. The preferred way to configure backups is through
# the admin UI at Settings → Service Providers (service: backup).
backup:
    provider: r2
    endpoint: ""
    access_key: ""
    secret_key: ""
    bucket_prefix: libreserv-backup

tunnel:
    provider: cloudflare
    api_token: ""
    account_id: ""

relay:
    hetzner_api_key: ""
    akamai_api_key: ""
    fallback_label: homelab

web:
    customer_dir: web/customer/dist
    admin_dir: web/admin/dist

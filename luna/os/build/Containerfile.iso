# Toolchain for the rapidinstall ISO, no live-build and no root: mmdebstrap
# builds the Debian live system, mksquashfs packs it, grub-mkrescue +
# xorriso make the BIOS+UEFI hybrid image. Used by build/iso.sh, which never
# calls podman.
# debian:bookworm, pinned by digest (the release tool builds this image
# without build arguments, so this default is the pin).
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:2c037a04925515fdd6ea85ea14a682d0e79931f5e9f5d07b6dbfc6ba12f9e858
FROM ${DEBIAN_IMAGE}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      mmdebstrap debian-archive-keyring ca-certificates \
      squashfs-tools xorriso mtools dosfstools \
      grub-common grub-pc-bin grub-efi-amd64-bin \
      xz-utils zstd \
 && rm -rf /var/lib/apt/lists/*

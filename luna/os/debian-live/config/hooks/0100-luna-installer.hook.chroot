#!/bin/bash
# Enable Luna installer on tty1 — no login prompt on the install stick.
set -e

chmod +x /usr/lib/luna-installer/start.sh

systemctl enable luna-installer.service
systemctl mask getty@tty1.service
systemctl mask getty@ttyS0.service 2>/dev/null || true
systemctl mask serial-getty@ttyS0.service 2>/dev/null || true

# Fallback if a getty still wins the race: Debian live user, blank password.
if id user >/dev/null 2>&1; then
	passwd -d user >/dev/null 2>&1 || true
fi

systemctl mask systemd-networkd-wait-online.service 2>/dev/null || true

#!/bin/sh
# Last live-config component: hand tty1 to rapidinstall (no login prompt).
. /lib/live/config.sh

Init() {
	echo -n " luna-installer"
}

_take_tty1() {
	# Generators may recreate getty@tty1 under /run despite /etc masks.
	systemctl stop 'getty@tty1.service' 2>/dev/null || true
	systemctl mask 'getty@tty1.service' 2>/dev/null || true
	rm -f /run/systemd/generator/getty.target.wants/getty@tty1.service
	rm -f /run/systemd/generator/getty@tty1.service.d/live-config_autologin.conf
	rm -f /run/systemd/system/getty@tty1.service.d/live-config_autologin.conf
	systemctl daemon-reload 2>/dev/null || true
}

Config() {
	_take_tty1
	if [ ! -x /usr/lib/luna-installer/start.sh ]; then
		echo "Luna installer missing." >&2
		return 1
	fi
	# openvt attaches a controlling terminal on tty1 for rapidinstall.
	openvt -c 1 -f -s -w -- /usr/lib/luna-installer/start.sh
	touch /var/lib/live/config/luna-installer
}

Init
Config

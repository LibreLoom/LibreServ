#!/bin/sh
# Initramfs entry for the Luna rapidinstall ISO.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [ -x /bin/busybox ]; then
	/bin/busybox --install -s 2>/dev/null || true
fi
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null || mount -t tmpfs dev /dev
mkdir -p /dev/pts /src /tmp
ln -sf /proc/self/fd /dev/fd 2>/dev/null || true

# shellcheck disable=SC1091
. /find-media.sh

load_modules() {
	if [ ! -d /lib/modules ]; then
		return 0
	fi
	for m in isofs iso9660 sr_mod cdrom usb-common usbcore ehci-hcd ehci-pci \
		xhci-hcd xhci-pci xhci-pci-renesas usb-storage uas \
		hid hid-generic usbhid evdev atkbd i8042 serio libps2 \
		mmc_core mmc_block sdhci sdhci-pci sdhci-acpi \
		pinctrl-intel pinctrl-cherryview pwm-lpss pwm-lpss-pci \
		ahci sd_mod nvme virtio virtio_pci virtio_blk virtio_scsi \
		ext4 fat vfat nls_cp437 crc32c_generic crc32c; do
		modprobe "$m" 2>/dev/null || true
	done
	mdev -s 2>/dev/null || true
}

load_modules

SRCDEV=""
i=0
while [ "$i" -lt 40 ]; do
	if SRCDEV="$(luna_find_install_media /src)"; then
		break
	fi
	SRCDEV=""
	sleep 1
	i=$((i + 1))
	load_modules
done

if [ ! -f /src/rapidinstall.sh ]; then
	echo "Could not find the Luna installer files on the USB stick."
	echo "Devices Luna can see:"
	ls /sys/class/block 2>/dev/null || true
	if command -v blkid >/dev/null 2>&1; then
		blkid || true
	fi
	echo "Dropping to a shell."
	exec setsid cttyhack sh
fi
export LUNA_INSTALL_MEDIA="$SRCDEV"
cd /src
# cttyhack attaches the keyboard/console so "type install luna" works.
exec setsid cttyhack /bin/sh /src/rapidinstall.sh

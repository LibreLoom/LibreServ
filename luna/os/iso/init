#!/bin/busybox sh
# Initramfs entry for the Luna rapidinstall ISO.
# Invoke applets through /bin/busybox so dangling install-time symlinks cannot
# take PID 1 down.
BB=/bin/busybox
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
$BB --install -s 2>/dev/null || true
$BB mount -t proc proc /proc
$BB mount -t sysfs sys /sys
$BB mount -t devtmpfs dev /dev 2>/dev/null || $BB mount -t tmpfs dev /dev
$BB mkdir -p /dev/pts /src /tmp
$BB ln -sf /proc/self/fd /dev/fd 2>/dev/null || true

# shellcheck disable=SC1091
. /find-media.sh

load_modules() {
	if [ ! -d /lib/modules ]; then
		return 0
	fi
	for m in isofs iso9660 sr_mod cdrom usb-common usbcore ehci-hcd ehci-pci \
		xhci-hcd xhci-pci xhci-pci-renesas usb-storage uas \
		hid hid-generic usbhid evdev atkbd i8042 serio libps2 \
		mmc_core mmc_block sdhci sdhci-pci sdhci-acpi \
		pinctrl-intel pinctrl-cherryview pwm-lpss pwm-lpss-pci \
		ahci sd_mod nvme virtio virtio_pci virtio_blk virtio_scsi \
		ext4 fat vfat nls_cp437 crc32c_generic crc32c; do
		modprobe "$m" 2>/dev/null || true
	done
	$BB mdev -s 2>/dev/null || true
}

load_modules

SRCDEV=""
i=0
while [ "$i" -lt 40 ]; do
	if SRCDEV="$(luna_find_install_media /src)"; then
		break
	fi
	SRCDEV=""
	$BB sleep 1
	i=$((i + 1))
	load_modules
done

run_console() {
	if $BB --list 2>/dev/null | $BB grep -q '^cttyhack$'; then
		exec $BB setsid $BB cttyhack $BB sh "$@"
	fi
	exec $BB setsid $BB sh -c 'exec /bin/busybox sh "$@"' _ "$@" <>/dev/console 2>&1
}

if [ ! -f /src/rapidinstall.sh ]; then
	echo "Could not find the Luna installer files on the USB stick."
	echo "Devices Luna can see:"
	$BB ls /sys/class/block 2>/dev/null || true
	if command -v blkid >/dev/null 2>&1; then
		blkid || true
	fi
	echo "Dropping to a shell."
	run_console
fi
export LUNA_INSTALL_MEDIA="$SRCDEV"
cd /src
run_console /src/rapidinstall.sh

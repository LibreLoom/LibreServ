<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luna_page"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/folderToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/luna_page"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/setup_folder_title"
        app:titleTextColor="@color/luna_ink" />

    <TextView
        android:id="@+id/folderPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:textColor="@color/luna_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/folderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:textColor="@color/luna_ink"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/folderList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/luna_divider"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderUp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/up_one_folder" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderNew"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/new_folder" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderUse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_this_folder" />
    </LinearLayout>
</LinearLayout>

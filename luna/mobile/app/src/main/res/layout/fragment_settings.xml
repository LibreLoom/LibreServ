<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luna_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingBottom="8dp"
            android:text="@string/when_to_backup"
            android:textColor="@color/luna_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/requireWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/require_wifi"
            android:textColor="@color/luna_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/require_wifi_help"
            android:textColor="@color/luna_ink"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/requireCharging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/require_charging"
            android:textColor="@color/luna_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="@string/require_charging_help"
            android:textColor="@color/luna_ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingBottom="8dp"
            android:text="@string/where_to_save"
            android:textColor="@color/luna_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/destinationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textColor="@color/luna_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/destinationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:textColor="@color/luna_ink"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseFolder"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/choose_folder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingBottom="8dp"
            android:text="@string/background_heading"
            android:textColor="@color/luna_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/luna_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/batteryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/allow_background"
            android:textColor="@color/luna_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luna_page">

    <ScrollView
        android:id="@+id/driveStep"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="16dp"
                android:text="@string/app_name"
                android:textColor="@color/luna_ink"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="8dp"
                android:text="@string/setup_drive_title"
                android:textColor="@color/luna_ink"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/setup_drive_help"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/driveList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/driveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:textColor="@color/luna_ink"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continue_label" />

            <TextView
                android:id="@+id/setupSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/sign_out"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/permissionStep"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="16dp"
                android:text="@string/setup_perm_title"
                android:textColor="@color/luna_ink"
                android:textSize="20sp" />

            <!-- Card on the page: text is luna_ink. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/luna_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/permPhotosRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_photos_title"
                        android:textColor="@color/luna_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_photos_body"
                        android:textColor="@color/luna_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/luna_chip_filled"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/perm_required"
                    android:textColor="@color/luna_page"
                    android:textSize="12sp" />
            </LinearLayout>

            <include
                android:id="@+id/permPhotosDivider"
                layout="@layout/view_row_divider" />

            <LinearLayout
                android:id="@+id/permLocationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_location_title"
                        android:textColor="@color/luna_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_location_body"
                        android:textColor="@color/luna_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/luna_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/perm_optional"
                    android:textColor="@color/luna_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <include
                android:id="@+id/permLocationDivider"
                layout="@layout/view_row_divider" />

            <LinearLayout
                android:id="@+id/permNotifyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_notify_title"
                        android:textColor="@color/luna_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_notify_body"
                        android:textColor="@color/luna_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/luna_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/perm_optional"
                    android:textColor="@color/luna_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <include
                android:id="@+id/permNotifyDivider"
                layout="@layout/view_row_divider" />

            <LinearLayout
                android:id="@+id/permBatteryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_battery_title"
                        android:textColor="@color/luna_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_battery_body"
                        android:textColor="@color/luna_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/luna_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/perm_optional"
                    android:textColor="@color/luna_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/grantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:textColor="@color/luna_ink"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grantButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_continue" />

            <TextView
                android:id="@+id/permSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="16dp"
                android:text="@string/sign_out"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luna_page">

    <ScrollView
        android:id="@+id/driveStep"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="8dp"
                android:text="@string/app_name"
                android:textColor="@color/luna_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="8dp"
                android:text="@string/setup_drive_title"
                android:textColor="@color/luna_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/setup_drive_help"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/driveList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/driveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:textColor="@color/luna_ink"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continue_label" />

            <TextView
                android:id="@+id/setupSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/sign_out"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/permissionStep"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:text="@string/setup_perm_title"
                android:textColor="@color/luna_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="4dp"
                android:text="@string/perm_photos_title"
                android:textColor="@color/luna_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/perm_photos_body"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="4dp"
                android:text="@string/perm_notify_title"
                android:textColor="@color/luna_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/perm_notify_body"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="4dp"
                android:text="@string/perm_battery_title"
                android:textColor="@color/luna_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="20dp"
                android:text="@string/perm_battery_body"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/grantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:textColor="@color/luna_ink"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grantButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant" />

            <TextView
                android:id="@+id/permSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="16dp"
                android:text="@string/sign_out"
                android:textColor="@color/luna_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

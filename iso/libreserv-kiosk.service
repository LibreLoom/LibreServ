[Unit]
Description=LibreServ Kiosk Browser
Documentation=https://libreloom.org
After=libreserv-server.service
Requires=libreserv-server.service

[Service]
Type=simple
User=libreserv
Environment=DISPLAY=:0
Environment=XDG_SESSION_TYPE=x11
ExecStartPre=/usr/bin/bash -c 'while ! curl -sf http://localhost:8080/api/v1/setup/status >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/librewolf --kiosk http://localhost:8080/setup
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

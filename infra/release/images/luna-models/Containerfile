# Builds the search models pack for the OS image (luna/scripts/build-models-pack.sh):
# curl fetches the pinned model files (checked by sha256 in the script), onnx
# cuts the two TinyCLIP encoders out of the ONNX export, zstd + tar make the pack.
FROM docker.io/library/python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
RUN apt-get update && apt-get install -y --no-install-recommends curl zstd ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir onnx==1.23.2

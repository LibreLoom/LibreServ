# flatpak-builder for the Luna Desktop Flatpak bundle.
# Jobs in this image need nested bubblewrap: see run-options.
# The job adds the flathub remote to the *user* installation, which lives in a
# cache volume together with the GNOME runtimes, so nothing is baked in here.
FROM registry.fedoraproject.org/fedora@sha256:e78cd1a688cd079c23864f289a89a49a3f4ad66d817864e325e1d058310ee95c
RUN dnf -y install flatpak flatpak-builder bubblewrap git xz tar elfutils ca-certificates appstream \
    && dnf clean all
ENV HOME=/root
WORKDIR /work

# Cross-compiles Luna Desktop for Windows (MinGW-w64) and packs the NSIS installer.
# python3, zstd and glib-compile-schemas are what packaging/windows/build-cross.sh needs
# besides the compilers (DLL collection, MSYS2 packages, GSettings schemas); plain
# gcc is for cargo build scripts, which run on the host.
FROM docker.io/library/debian@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ENV DEBIAN_FRONTEND=noninteractive RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      gcc libc6-dev gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 binutils-mingw-w64-x86-64 nsis \
      curl ca-certificates git xz-utils zip unzip zstd pkg-config file \
      python3 libglib2.0-bin \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -fsSLo /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init \
    && echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.96.0 --target x86_64-pc-windows-gnu \
    && rm /tmp/rustup-init \
    && chmod -R a+rwX /usr/local/rustup /usr/local/cargo
WORKDIR /src

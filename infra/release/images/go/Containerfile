# Go toolchain for Sol / Connect backends, the release tool itself, and ./ci.
FROM docker.io/library/golang@sha256:eb36c1664dd974cde625f736e02c204383deebe03977365caaec5bf49f794348
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends git zip xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src

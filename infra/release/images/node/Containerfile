# Node toolchain for the React/Vite web bundles (Sol, Luna, Connect).
FROM docker.io/library/node@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends git zip xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
